# ==========================================
# EVENTRA Environment Configuration Template
# ==========================================

# Database Configuration
POSTGRES_USER=eventra_user
POSTGRES_PASSWORD=eventra_password
POSTGRES_DB=eventra_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eventra_user:eventra_password@localhost:5432/eventra_db

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# AI / LLM Provider Configuration
LLM_PROVIDER=gemini # Options: gemini, mock
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Aoede

# Maps & Geolocation (Location Discovery & Travel ETA)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Google Maps Scraper Kit (Local Scraper Adapter)
GOOGLE_MAPS_SCRAPER_URL=http://localhost:8080
GOOGLE_MAPS_SCRAPER_TIMEOUT=45
GOOGLE_MAPS_SCRAPER_MAX_DEPTH=5
GOOGLE_MAPS_SCRAPER_FALLBACK_TO_MOCK=true

# ==========================================
# Communication Provider Configuration
# ==========================================
# Controls how EVENTRA contacts vendors (WhatsApp message or AI voice call).
# CRITICAL: If left unset or set to "mock", ALL vendor contact falls back to
# MockCommunicationProvider — no real WhatsApp messages or phone calls are dispatched.
# Set to "openwa" for WhatsApp via the local container, or "exotel" for voice calling.
COMMUNICATION_PROVIDER=mock

# Self-Hosted OpenWA WhatsApp Gateway Configuration
# Required when COMMUNICATION_PROVIDER=openwa.
# If OPENWA_ENABLED=false or left unset, messaging falls back to Mock.
OPENWA_ENABLED=false
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=your-openwa-api-key-here
OPENWA_SESSION_ID=eventra_ops
OPENWA_WEBHOOK_SECRET=your-openwa-webhook-signing-secret
OPENWA_TIMEOUT_SECONDS=10

# Legacy WhatsApp Cloud API settings (optional fallback)
WHATSAPP_API_KEY=your-whatsapp-business-api-key
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-whatsapp-webhook-verify-token

# Exotel Telephony Configuration (Voice Integration)
# Required when COMMUNICATION_PROVIDER=exotel or EXOTEL_ENABLED=true.
# NOTE: Your Exotel account must be KYC-compliant on Exotel dashboard for outbound calls.
EXOTEL_ENABLED=false
EXOTEL_API_KEY=your-exotel-api-key-here
EXOTEL_API_TOKEN=your-exotel-api-token-here
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_ACCOUNT_SID=your-exotel-account-sid-here
EXOTEL_CALLER_ID=your-exotel-caller-id-here
EXOTEL_APP_ID=your-exotel-app-id-here
# Publicly accessible WebSocket URL for bidirectional telephony audio streaming.
# In local development, use an ngrok or Cloudflare tunnel pointing to /api/v1/voice/exotel/stream
# Example: wss://abc123.ngrok-free.app/api/v1/voice/exotel/stream
# Outbound calls will fail loudly if this is left unset.
EXOTEL_STREAM_URL=
EXOTEL_CALLBACK_URL=http://localhost:8000/api/v1/voice/exotel/callback

# Push Notifications (Web Push / VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CLAIM_EMAIL=admin@eventra.local

# Frontend Client Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
