# ==========================================
# EVENTRA Environment Configuration Template
# ==========================================

# Database Configuration
POSTGRES_USER=eventra_user
POSTGRES_PASSWORD=eventra_password
POSTGRES_DB=eventra_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eventra_user:eventra_password@localhost:5432/eventra_db

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# AI / LLM Provider Configuration
LLM_PROVIDER=gemini # Options: gemini, mock
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=your-gemini-api-key-here

# Maps & Geolocation (Location Discovery & Travel ETA)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Google Maps Scraper Kit (Local Scraper Adapter)
GOOGLE_MAPS_SCRAPER_URL=http://localhost:8080
GOOGLE_MAPS_SCRAPER_TIMEOUT=45
GOOGLE_MAPS_SCRAPER_MAX_DEPTH=5
GOOGLE_MAPS_SCRAPER_FALLBACK_TO_MOCK=true

# WhatsApp Provider Communication (SPECIAL DOUBT)
WHATSAPP_API_KEY=your-whatsapp-business-api-key
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-whatsapp-webhook-verify-token

# Push Notifications (Web Push / VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CLAIM_EMAIL=admin@eventra.local

# Frontend Client Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
